{
  "name": "cj-gadget-store-server",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore settings.json --ignore products.json --ignore orders.json server.js",
    "build": "cd ../client && npm install && npm run build && mkdir -p ../server/public && cp -r dist/* ../server/public/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
